# Render supplies PORT automatically.
HOST=0.0.0.0
PORT=8000

# Use /var/data/users.sqlite3 after attaching a Render persistent disk at /var/data.
DATABASE_PATH=/var/data/users.sqlite3

# Exact Vercel frontend origin; do not include a trailing slash.
FRONTEND_ORIGIN=https://your-project.vercel.app

# Required when the frontend and backend use different HTTPS domains.
COOKIE_SECURE=1

# Disable seeded demo accounts in production.
ENABLE_DEMO_LOGIN=0
